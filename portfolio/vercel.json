{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "images": {
    "sizes": [640, 750, 828, 1080, 1200, 1920, 2048, 3840],
    "domains": ["*"],
    "minimumCacheTTL": 60
  },
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://your-production-url.vercel.app"
  }
}
